                                        },
                                        "errors": {
                                            "properties": {
                                                "name": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "The organization name must be at least 3 characters long."
                                                    }
                                                },
                                                "tax_id": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "The organization's tax ID must be at least 11 characters long."
                                                    }
