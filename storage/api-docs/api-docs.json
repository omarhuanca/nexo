                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Organization not found with ID: 99"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
